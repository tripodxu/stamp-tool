{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "印章工具",
  "version": "0.1.0",
  "identifier": "cn.stamptool.pdf",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev -- --port 5183",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "印章工具 · PDF 公章盖章",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}